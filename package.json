{
  "name": "shine-css",
  "version": "0.2.0",
  "description": "Ultra-light pure-CSS framework (~17 KB gzip): utility classes, ready-made components and master design knobs. No JavaScript, no build step.",
  "style": "dist/shine.min.css",
  "main": "dist/shine.min.css",
  "unpkg": "dist/shine.min.css",
  "jsdelivr": "dist/shine.min.css",
  "exports": {
    ".": "./dist/shine.min.css",
    "./full": "./dist/shine.css",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node build.js && node docs.js",
    "docs": "node docs.js",
    "test": "node tests/smoke.js chromium firefox webkit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asticore/shine.git"
  },
  "keywords": [
    "css",
    "css-framework",
    "utility-css",
    "utility-first",
    "lightweight",
    "minimal",
    "no-javascript",
    "design-tokens",
    "theming",
    "dark-mode",
    "css-variables",
    "cascade-layers",
    "responsive",
    "components",
    "ui-kit",
    "frontend",
    "tailwind-alternative",
    "bootstrap-alternative",
    "accessibility"
  ],
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "homepage": "https://asticore.github.io/shine/docs/",
  "bugs": {
    "url": "https://github.com/asticore/shine/issues"
  }
}
